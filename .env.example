# --- Data provider ---
OPENWEBNINJA_API_KEY=your_key_here

# --- Models ---
ANTHROPIC_API_KEY=

# --- Database ---
DATABASE_URL=

# --- Object storage ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bliprank-answers

# --- Cache / queue ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Billing ---
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Observability ---
SENTRY_AUTH_TOKEN=
POSTHOG_KEY=

# --- Spend controls (CLAUDE.md rule R3) ---
COLLECTION_ENABLED=false
COLLECTION_BUDGET_USD_DAILY=25
COLLECTION_WINDOW_HOURS=24
COLLECTION_MAX_RPS=5

# Collector runtime topology (ADR-0006): single-process | fleet.
# Undeclared is REFUSED, not defaulted - a process that cannot show it is alone
# does not get a per-process spend cap or rate bucket.
COLLECTOR_TOPOLOGY=single-process

# --- Grader live scanning (local demo only) ---------------------------------
# BOTH must be exactly 'true' before the Grader form can reach a provider. Two
# flags, not one, because a public form wired to collection is an unmetered
# spend trigger and P3.6 (Turnstile, per-IP cap) does not exist yet.
GRADER_LIVE_SCAN=false
# New (uncached) domains a UTC day may trigger. The provider quota is the real
# ceiling and is read live from /usage; this is the burst guard that catches a
# double-submit before the quota has to.
GRADER_MAX_NEW_SCANS_PER_DAY=2
# Prompts per engine in one scan. 17 = the unprompted set (discovery +
# problem-led); the branded groups are excluded by design, not by economy.
GRADER_PROMPTS_PER_SCAN=17
# The cap a NEW ledger is created with. Once services/grader/data-live/ledger.json
# exists, ITS cap wins and this is ignored — a smaller value here used to be
# written back over a deliberately raised ledger on the first charged call.
# Changing an existing cap means editing that file; Budget throws on any other raise.
GRADER_CAP_USD=5
