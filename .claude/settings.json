{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "COLLECTION_ENABLED": "true"
  },
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(npm run *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(pnpm test*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint*)",
      "Bash(pnpm drizzle-kit *)",
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "Glob(*)",
      "Grep(*)",
      "Bash(npx @claude-flow*)",
      "Bash(node .claude/*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(*OPENWEBNINJA_API_KEY*)",
      "Read(./.env*)",
      "Read(./**/*.pem)",
      "Bash(curl *api.openwebninja.com*)",
      "Bash(node services/collector/**)",
      "Bash(npx ruflo*)",
      "Bash(npx -y ruflo*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(pnpm deploy*)",
      "Bash(wrangler *)",
      "Bash(pnpm db:migrate*)",
      "Bash(pnpm backfill*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-spend.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-end.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ruflo-testgen@ruflo": true,
    "ruflo-browser@ruflo": true,
    "ruflo-cost-tracker@ruflo": false,
    "ruflo-adr@ruflo": true,
    "ruflo-metaharness@ruflo": true,
    "frontend-design@claude-plugins-official": false,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true
  },
  "extraKnownMarketplaces": {
    "ruflo": {
      "source": {
        "source": "github",
        "repo": "ruvnet/ruflo"
      }
    },
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "sooraj-shaji/ui-ux-pro-max-skill"
      }
    }
  }
}
